rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Phase 4: Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['buyer', 'wholesaler'] &&
             data.keys().size() >= 2 && data.keys().size() <= 10 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['sellerId', 'name', 'wholesalePrice', 'stock']) &&
             data.keys().size() >= 4 && data.keys().size() <= 12 &&
             data.sellerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.wholesalePrice is number && data.wholesalePrice >= 0 &&
             data.stock is number && data.stock >= 0 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'sellerId', 'status', 'totalAmount']) &&
             data.keys().size() >= 4 && data.keys().size() <= 10 &&
             (data.buyerId == request.auth.uid || data.sellerId == request.auth.uid) &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'] &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['sellerId', 'totalAmount', 'createdAt']) &&
             data.keys().size() >= 3 && data.keys().size() <= 10 &&
             data.sellerId == request.auth.uid &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.createdAt == request.time;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().keys().size() == 4; // uid, role, email, displayName initially
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                    incoming().role == existing().role &&
                    incoming().uid == existing().uid;
    }

    // 2. Products Collection
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isOwner(existing().sellerId) && 
                    isValidProduct(incoming()) &&
                    incoming().sellerId == existing().sellerId;
      allow delete: if isSignedIn() && isOwner(existing().sellerId);
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().buyerId) || isOwner(existing().sellerId));
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().buyerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled') ||
        (isOwner(existing().sellerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      ) && isValidOrder(incoming()) &&
      incoming().buyerId == existing().buyerId &&
      incoming().sellerId == existing().sellerId;
    }

    // 4. Sales Collection (Ledger)
    match /sales/{saleId} {
      allow get: if isSignedIn() && isOwner(existing().sellerId);
      allow list: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid && isValidSale(incoming());
      allow update: if false; // Sales records should be immutable for ledger integrity
      allow delete: if false;
    }
  }
}
