rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow connection testing (Mandatory Constraint)
    match /test/connection {
      allow get: if true;
    }

    // Phase 3: Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Mandatory Email Verification for Writes (Pillar 2)
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && data.role in ['buyer', 'wholesaler']
          && (data.displayName is string && data.displayName.size() <= 100)
          && (data.keys().hasAll(['uid', 'role']));
      }

      // Pillar 6: PII Isolation - allow reading if self or if looking up a wholesaler
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.role == 'wholesaler');
      allow list: if false; // Prevention of user scraping
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'whatsappNumber', 'shopNo', 'block', 'location', 'businessDescription', 'openingHours', 'returnPolicy', 'businessName']);
    }

    // Unique Email Tracking
    match /unique_emails/{email} {
      allow get: if true;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid && !exists(/databases/$(database)/documents/unique_emails/$(email));
    }

    // 2. Products Collection
    match /products/{productId} {
      function isValidProduct(data) {
        return data.sellerId == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.wholesalePrice is number && data.wholesalePrice >= 0
          && data.stock is number && data.stock >= 0;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isSignedIn() && existing().sellerId == request.auth.uid && isValidProduct(incoming());
      allow delete: if isSignedIn() && existing().sellerId == request.auth.uid;
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled']
          && data.totalAmount is number && data.totalAmount >= 0;
      }

      allow get: if isSignedIn() && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid && isValidOrder(incoming());
      allow update: if isSignedIn() 
        && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
        && (
          // Action: Wholesaler updates status
          (existing().sellerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          // Action: Buyer cancels
          (existing().buyerId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        );
    }

    // 4. Sales Ledger (Wholesaler only)
    match /sales/{saleId} {
      allow get: if isSignedIn() && existing().sellerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
    }

    // 5. Business Expenses (Wholesaler only)
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && existing().sellerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
    }

    // 6. Product Reviews
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.buyerId == request.auth.uid
          && data.productId is string && data.productId.size() <= 128
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.comment is string && data.comment.size() <= 1000;
      }

      allow get, list: if true; // Public reviews
      allow create: if isSignedIn() && isValidReview(incoming()) && isValidId(reviewId);
      allow delete: if isSignedIn() && existing().buyerId == request.auth.uid;
    }

    // 7. Notifications (Inquiries)
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (existing().wholesalerId == request.auth.uid || existing().buyerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.wholesalerId == request.auth.uid || resource.data.buyerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid;
      allow update: if isSignedIn() && existing().wholesalerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }
  }
}
